{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome (no Security)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5500",
      "webRoot": "${workspaceFolder}",
      "runtimeArgs": [
        "--disable-web-security",
        "--user-data-dir=${workspaceFolder}/.chrome-dev"
      ]
    }
  ]
}